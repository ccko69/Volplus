<vector xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:aapt="http://schemas.android.com/aapt"
  android:width="240dp"
  android:height="240dp"
  android:viewportHeight="240"
  android:viewportWidth="240">
  <!-- Background: The calm lake with a central glow -->
  <path android:fillAlpha="1"
    android:pathData="M0,0h240v240h-240z">
    <aapt:attr name="android:fillColor">
      <gradient android:centerX="120"
        android:centerY="120"
        android:gradientRadius="120"
        android:type="radial">
        <item android:color="#9981D4FA"
          android:offset="0.0"/>
        <item android:color="#CC0288D1"
          android:offset="0.5"/>
        <item android:color="#0029B6F6"
          android:offset="1.0"/>
      </gradient>
    </aapt:attr>
  </path>
  <!-- Outer Wave -->
  <path android:pathData="M120,120m-70,0a70,70 0,1 1,140 0a70,70 0,1 1,-140 0"
    android:strokeColor="#81D4FA"
    android:strokeWidth="8"/>
  <!-- Middle Wave -->
  <path android:pathData="M120,120m-40,0a40,40 0,1 1,80 0a40,40 0,1 1,-80 0"
    android:strokeColor="#29B6F6"
    android:strokeWidth="12"/>
  <!-- Inner Wave -->
  <path android:pathData="M120,120m-10,0a10,10 0,1 1,20 0a10,10 0,1 1,-20 0"
    android:strokeColor="#0288D1"
    android:strokeWidth="14"/>
</vector>
